<Project Sdk="MSTest.Sdk/4.5.2">

  <PropertyGroup>
    <AssemblyName>Medo.Config.Tests</AssemblyName>
    <RootNamespace>Tests</RootNamespace>
  </PropertyGroup>

  <PropertyGroup>
    <TargetFrameworks>net11.0;net10.0</TargetFrameworks>
    <LangVersion>latest</LangVersion>
    <IsPackable>false</IsPackable>
    <Nullable>disable</Nullable>
  </PropertyGroup>

  <PropertyGroup>
    <RunAnalyzersDuringBuild>false</RunAnalyzersDuringBuild>
    <EnableNETAnalyzers>false</EnableNETAnalyzers>
    <SuppressTfmSupportBuildErrors>true</SuppressTfmSupportBuildErrors>
  </PropertyGroup>

  <ItemGroup>
    <Compile Include="../Medo.Config.Tests/*.cs" />
  </ItemGroup>
  <ItemGroup>
    <EmbeddedResource Include="../Medo.Config.Tests/_Resources/**" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="../../src/MultiFramework/Medo.Config.csproj" />
  </ItemGroup>

</Project>
